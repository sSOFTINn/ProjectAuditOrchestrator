{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pao.dev/schemas/doctor/v1",
  "title": "PAO read-only installation readiness result",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "status", "profile", "scope", "checked_at", "producer_status", "target_inspected", "scanner_started", "network_access", "isolation_tested", "checks"],
  "properties": {
    "api_version": {"const": "pao.dev/doctor/v1"},
    "status": {"enum": ["READY", "SETUP_REQUIRED"]},
    "profile": {"enum": ["fast", "deep-sca", "license", "secrets", "sast", "ci-security", "sbom-quality", "mvp"]},
    "scope": {"const": "profile-prerequisites"},
    "checked_at": {"type": "string", "format": "date-time"},
    "producer": {"$ref": "https://pao.dev/schemas/producer/v1"},
    "producer_status": {"enum": ["RECORDED", "UNAVAILABLE"]},
    "target_inspected": {"const": false},
    "scanner_started": {"const": false},
    "network_access": {"const": false},
    "isolation_tested": {"const": false},
    "checks": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "status", "reason"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 128},
          "status": {"enum": ["READY", "SETUP_REQUIRED"]},
          "reason": {"type": "string", "minLength": 1},
          "next_action": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"producer_status": {"const": "RECORDED"}}}, "then": {"required": ["producer"]}},
    {"if": {"properties": {"producer_status": {"const": "UNAVAILABLE"}}}, "then": {"not": {"required": ["producer"]}, "properties": {"status": {"const": "SETUP_REQUIRED"}}}}
  ],
  "$comment": "READY establishes profile prerequisites only. Doctor never scans a target, starts scanners, proves isolation, updates inputs or grants security/legal approval."
}
