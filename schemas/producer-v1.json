{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pao.dev/schemas/producer/v1",
  "title": "PAO run or report producer identity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "version",
    "revision",
    "source_state",
    "source_tree_sha256",
    "executable_sha256",
    "go_version",
    "identity_status"
  ],
  "properties": {
    "api_version": {
      "const": "pao.dev/producer/v1"
    },
    "version": {
      "anyOf": [
        {
          "const": "dev"
        },
        {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
        }
      ]
    },
    "revision": {
      "anyOf": [
        {
          "const": "unknown"
        },
        {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      ]
    },
    "source_state": {
      "enum": [
        "unknown",
        "clean",
        "modified"
      ]
    },
    "source_tree_sha256": {
      "anyOf": [
        {
          "const": "unknown"
        },
        {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      ]
    },
    "executable_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "go_version": {
      "type": "string",
      "pattern": "^go[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "identity_status": {
      "enum": [
        "DEVELOPMENT",
        "RELEASE_CANDIDATE",
        "MODIFIED"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "identity_status": {
            "const": "RELEASE_CANDIDATE"
          }
        }
      },
      "then": {
        "properties": {
          "source_state": {
            "const": "clean"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
          },
          "revision": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "source_tree_sha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "identity_status": {
            "const": "MODIFIED"
          }
        }
      },
      "then": {
        "properties": {
          "source_state": {
            "const": "modified"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
          },
          "revision": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "source_tree_sha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      }
    }
  ],
  "$comment": "Identifiers describe recorded production bytes. Schema validation does not verify a binary hash, clean source, signature, historical run lineage or publication approval."
}
