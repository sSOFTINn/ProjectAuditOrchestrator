{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pao.dev/schemas/adapter-manifest/v1alpha2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "id",
    "display_name",
    "upstream",
    "capabilities",
    "supported_platforms",
    "input_kinds",
    "output_kinds",
    "source_license",
    "redistribution",
    "network",
    "writes_target",
    "executes_target_code",
    "timeout_seconds",
    "parser_schema",
    "fixed_arguments",
    "required_sandbox",
    "prerequisite_kinds",
    "fixture_cases",
    "max_output_bytes",
    "redaction_class"
  ],
  "properties": {
    "api_version": {
      "const": "pao.dev/adapter/v1alpha2"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "upstream": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "$ref": "#/$defs/nonemptyStrings"
    },
    "supported_platforms": {
      "$ref": "#/$defs/nonemptyStrings"
    },
    "input_kinds": {
      "$ref": "#/$defs/nonemptyStrings"
    },
    "output_kinds": {
      "$ref": "#/$defs/nonemptyStrings"
    },
    "source_license": {
      "type": "string",
      "minLength": 1
    },
    "redistribution": {
      "type": "string",
      "minLength": 1
    },
    "network": {
      "const": "never-during-audit"
    },
    "writes_target": {
      "const": false
    },
    "executes_target_code": {
      "const": false
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "input_indicators": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "parser_schema": {
      "type": "string",
      "minLength": 1
    },
    "fixed_arguments": {
      "$ref": "#/$defs/nonemptyStrings"
    },
    "allowed_environment": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "success_exit_codes": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      },
      "uniqueItems": true,
      "anyOf": [
        {
          "maxItems": 0
        },
        {
          "contains": {
            "const": 0
          }
        }
      ]
    },
    "required_sandbox": {
      "$ref": "#/$defs/nonemptyStrings"
    },
    "prerequisite_kinds": {
      "$ref": "#/$defs/nonemptyStrings"
    },
    "fixture_cases": {
      "$ref": "#/$defs/nonemptyStrings"
    },
    "max_output_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "redaction_class": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "compatible_tool_versions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^\\s\u0000\r\n](?:[^\u0000\r\n]*[^\\s\u0000\r\n])?$"
      }
    }
  },
  "$defs": {
    "nonemptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
