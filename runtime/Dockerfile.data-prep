FROM debian:stable-slim@sha256:04634311a8d5fc442b6eb06d792293c4f3e2268652ca7634e00ce8ef5cc0a28a

# Connected preparation only: this image exists solely to obtain advisory data through verified TLS.
# It is never a PAO audit runtime and contains neither scanners nor cached vulnerability data.
RUN apt-get update \
    && apt-get install --no-install-recommends --yes ca-certificates \
    && rm -rf /var/lib/apt/lists/*
